{
  "schema": "ECOMPANION_MOBILE_BOUNDARIES_V1",
  "authority": {
    "companion_identity": "runtime",
    "memory": "runtime",
    "device_state": "runtime",
    "client_secrets": "never_committed",
    "runtime_root_token_on_body": "forbidden",
    "device_credential": "scoped_revocable_only",
    "body_chat_companion_selection": "runtime_assigned_only",
    "body_chat_cross_companion_access": "forbidden",
    "relink_device_identity": "runtime_returned_existing_device_only"
  },
  "platform_independence": {
    "paid_platform_membership_required": false,
    "minimum_body_surface": "web_pwa",
    "native_sidecar_optional": true,
    "capability_negotiation_required": true,
    "self_hostable_transport_required": true
  },
  "pairing": {
    "method": "one_time_runtime_grant",
    "actor_assignment_authority": "runtime",
    "client_may_supply_actor_id": false,
    "root_bearer_entry_in_body_ui": false,
    "local_secret_class": "device_scoped_credential_only",
    "relink_method": "owner_created_one_time_grant",
    "relink_code_transport": "url_fragment_or_manual_entry",
    "relink_code_removed_from_url_after_boot": true,
    "relink_client_device_id_authority": false
  },
  "voice": {
    "input_adapter": "capability_negotiated_browser_speech_v1",
    "output_adapter": "capability_negotiated_browser_speech_synthesis_v1",
    "paid_provider_required": false,
    "runtime_chat_authority": "unchanged",
    "transcript_transport": "existing_body_chat_turn",
    "client_companion_selection": false,
    "custom_voice_provider": "optional_future_adapter"
  },
  "forbidden": [
    "hardcoded_companion_identity_in_client_core",
    "committed_runtime_tokens",
    "runtime_root_bearer_on_body",
    "client_selected_actor_authority",
    "client_selected_companion_chat_authority",
    "client_selected_relink_device_authority",
    "voice_bypass_runtime_conversation",
    "voice_adapter_selected_companion_authority",
    "apple_specific_identity_or_memory_authority",
    "vendor_only_core_transport",
    "silent_capability_assumptions"
  ],
  "baseline_capabilities": [
    "display",
    "audio_output",
    "microphone",
    "camera",
    "webrtc",
    "notifications",
    "web_push",
    "service_worker",
    "speech_recognition",
    "speech_synthesis"
  ]
}
